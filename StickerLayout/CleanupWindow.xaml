<Window x:Class="StickerLayout.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Height="780" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Ink0}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_KeyDown" SourceInitialized="Window_SourceInitialized">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Ink1}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource Cancel}" IsCancel="True" MinWidth="88"/>
                    <Button x:Name="ApplyBtn" Style="{StaticResource Primary}" Content="{DynamicResource Apply}" IsDefault="True" MinWidth="88" Margin="8,0,0,0" Click="Apply_Click"/>
                </StackPanel>
                <TextBlock x:Name="Info" Style="{StaticResource Label}" Typography.NumeralAlignment="Tabular"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Left" Width="272" Background="{StaticResource Ink1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <Button Style="{StaticResource Outline}" Click="Background_Click" HorizontalContentAlignment="Left" Padding="10,6"
                        AutomationProperties.Name="{DynamicResource CleanBg}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" FontSize="15"/>
                        <TextBlock Text="{DynamicResource CleanBg}" Margin="9,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{DynamicResource CleanBgHint}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE75C;" FontSize="15" Foreground="{StaticResource AccentText}"/>
                    <TextBlock Text="{DynamicResource CleanClick}" FontWeight="SemiBold" Margin="9,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource CleanClickHint}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <DockPanel Margin="0,20,0,0">
                    <TextBlock x:Name="TolText" DockPanel.Dock="Right" Width="30" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{DynamicResource Tolerance}" Style="{StaticResource Label}"/>
                </DockPanel>
                <Slider x:Name="Tol" Minimum="0" Maximum="255" Value="32" SmallChange="1" LargeChange="8" Margin="0,6,0,0"
                        ValueChanged="Tol_Changed" AutomationProperties.Name="{DynamicResource Tolerance}"/>

                <DockPanel Margin="0,16,0,0">
                    <TextBlock x:Name="EdgeText" DockPanel.Dock="Right" Width="30" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{DynamicResource Contract}" Style="{StaticResource Label}"/>
                </DockPanel>
                <Slider x:Name="Edge" Minimum="0" Maximum="3" Value="0" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0"
                        ValueChanged="Edge_Changed" AutomationProperties.Name="{DynamicResource Contract}"/>
                <TextBlock Text="{DynamicResource ContractHint}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button x:Name="UndoBtn" Click="Undo_Click" ToolTip="Ctrl+Z" AutomationProperties.Name="{DynamicResource Undo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="12"/>
                            <TextBlock Text="{DynamicResource Undo}" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResetBtn" Style="{StaticResource Ghost}" Click="Reset_Click" Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource Reset}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="12" Foreground="{StaticResource Dim}"/>
                            <TextBlock Text="{DynamicResource Reset}" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Background="{StaticResource Ink0}" ClipToBounds="True">
            <Border Background="{StaticResource Checker}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                <Image x:Name="View" Stretch="Uniform" Cursor="Cross" MouseLeftButtonDown="View_Down"
                       AutomationProperties.Name="{DynamicResource CleanClick}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
