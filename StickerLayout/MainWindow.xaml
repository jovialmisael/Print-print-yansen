<Window x:Class="StickerLayout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Title}" Width="1440" Height="900" MinWidth="1100" MinHeight="640" WindowState="Maximized"
        Background="{StaticResource Ink0}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragEnter="Window_DragOver" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized">
    <DockPanel>
        <!-- Baris menu -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Ink1}" Height="32" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
                <ContentControl Template="{StaticResource LogoMark}" Width="20" Height="20" Margin="12,0,8,0" Focusable="False"/>
                <TextBlock Text="Printech" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="{DynamicResource MFile}">
                        <MenuItem Header="{DynamicResource Add}" InputGestureText="Ctrl+O" Click="Add_Click"/>
                        <MenuItem Header="{DynamicResource Export}" InputGestureText="Ctrl+E" Click="Export_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Exit}" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource MEdit}">
                        <MenuItem Header="{DynamicResource Nest}" InputGestureText="Ctrl+L" Click="Nest_Click"/>
                        <MenuItem Header="{DynamicResource Compact}" Click="Compact_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource RotSel}" InputGestureText="R" Click="Rotate_Click"/>
                        <MenuItem Header="{DynamicResource DelSel}" InputGestureText="Del" Click="DeletePlaced_Click"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource MView}">
                        <MenuItem Header="{DynamicResource ZoomIn}" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                        <MenuItem Header="{DynamicResource ZoomOut}" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                        <MenuItem Header="{DynamicResource Fit}" InputGestureText="Ctrl+0" Click="Fit_Click"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Lang}">
                        <MenuItem x:Name="LangId" Header="Indonesia" Tag="id" IsChecked="True" Click="Lang_Click"/>
                        <MenuItem x:Name="LangEn" Header="English" Tag="en" Click="Lang_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- Options bar: aksi utama job -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Ink1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Click="Export_Click" ToolTip="Ctrl+E"
                        AutomationProperties.Name="{DynamicResource Export}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="13"/>
                        <TextBlock Text="{DynamicResource Export}" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Button Click="Add_Click" ToolTip="Ctrl+O" AutomationProperties.Name="{DynamicResource Add}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/>
                            <TextBlock Text="{DynamicResource Add}" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Primary}" Click="Nest_Click" Margin="8,0,0,0" ToolTip="Ctrl+L" AutomationProperties.Name="{DynamicResource Nest}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xECA5;" FontSize="13"/>
                            <TextBlock Text="{DynamicResource Nest}" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Click="Compact_Click" Margin="4,0,0,0" AutomationProperties.Name="{DynamicResource Compact}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73F;" FontSize="12" Foreground="{StaticResource Dim}"/>
                            <TextBlock Text="{DynamicResource Compact}" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Ink1}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Height="32" Padding="12,0,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Material}" Style="{StaticResource Label}"/>
                    <Border Width="84" Height="6" CornerRadius="3" Background="{StaticResource Ink3}" Margin="8,0" VerticalAlignment="Center">
                        <Border x:Name="UseBar" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Accent}" Width="0"/>
                    </Border>
                    <TextBlock x:Name="UseText" Width="34" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <Rectangle Width="1" Height="16" Fill="{StaticResource Line}" Margin="10,0"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="{DynamicResource ZoomOut}" AutomationProperties.Name="{DynamicResource ZoomOut}"/>
                    <Slider x:Name="ZoomSlider" Width="120" Minimum="10" Maximum="400" Value="50" ValueChanged="Zoom_Changed" VerticalAlignment="Center" Margin="2,0"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="{DynamicResource ZoomIn}" AutomationProperties.Name="{DynamicResource ZoomIn}"/>
                    <TextBlock x:Name="ZoomText" Width="42" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <Button Style="{StaticResource Ghost}" Content="{DynamicResource Fit}" Click="Fit_Click" Margin="8,0,0,0" Padding="9,0" MinHeight="24" ToolTip="Ctrl+0"/>
                </StackPanel>
                <Border x:Name="WarnPill" Visibility="Collapsed" Background="{StaticResource WarnBg}" CornerRadius="10" Padding="9,2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="11" Foreground="{StaticResource Warn}"/>
                        <TextBlock x:Name="WarnText" Foreground="{StaticResource Warn}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Status" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Batang alat -->
        <Border DockPanel.Dock="Left" Width="46" Background="{StaticResource Ink1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,8">
                <RadioButton x:Name="ToolMove" Style="{StaticResource Tool}" GroupName="Tool" Content="&#xE8B0;" IsChecked="True" Checked="Tool_Checked"
                             ToolTip="{DynamicResource TipMove}" AutomationProperties.Name="{DynamicResource TipMove}"/>
                <RadioButton x:Name="ToolHand" Style="{StaticResource Tool}" GroupName="Tool" Content="&#xE7C9;" Checked="Tool_Checked"
                             ToolTip="{DynamicResource TipHand}" AutomationProperties.Name="{DynamicResource TipHand}"/>
                <RadioButton x:Name="ToolZoom" Style="{StaticResource Tool}" GroupName="Tool" Content="&#xE71E;" Checked="Tool_Checked"
                             ToolTip="{DynamicResource TipZoom}" AutomationProperties.Name="{DynamicResource TipZoom}"/>
                <Rectangle Height="1" Fill="{StaticResource Line}" Margin="10,8"/>
                <Button Style="{StaticResource ToolBtn}" Content="&#xE7AD;" Click="Rotate_Click" ToolTip="{DynamicResource RotSel}" AutomationProperties.Name="{DynamicResource RotSel}"/>
                <Button Style="{StaticResource ToolBtn}" Content="&#xE74D;" Click="DeletePlaced_Click" ToolTip="{DynamicResource DelSel}" AutomationProperties.Name="{DynamicResource DelSel}"/>
            </StackPanel>
        </Border>

        <!-- Panel kanan -->
        <Border DockPanel.Dock="Right" Width="316" Background="{StaticResource Ink1}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Visible"> <!-- Visible, bukan Auto: Auto + teks wrap = layout berputar tanpa henti -->
                <StackPanel>
                    <Expander Style="{StaticResource Panel}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE81E;" FontSize="13" Foreground="{StaticResource Dim}"/>
                                <TextBlock Text="{DynamicResource SecFiles}" FontWeight="SemiBold" Margin="9,0,0,0"/>
                                <TextBlock x:Name="FileCount" Style="{StaticResource Label}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <ListBox x:Name="List" Style="{StaticResource Plain}" MaxHeight="340">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="3" Background="{StaticResource Checker}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                <Image Source="{Binding Preview}" Stretch="Uniform" Margin="3"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBox Width="50" Style="{StaticResource Num}" Text="{Binding WidthMm, StringFormat=0.#}" ToolTip="{DynamicResource WidthTip}"/>
                                                    <TextBlock Text="{Binding HText}" Style="{StaticResource Small}" Margin="5,0,10,0"/>
                                                    <TextBox Width="38" Style="{StaticResource Num}" Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource QtyTip}"/>
                                                    <TextBlock Text="pcs" Style="{StaticResource Small}" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" VerticalAlignment="Top" Click="RemoveItem_Click"
                                                    ToolTip="{DynamicResource Remove}" AutomationProperties.Name="{DynamicResource Remove}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel Margin="0,10,0,0">
                                <TextBox x:Name="WidthBox" Style="{StaticResource Num}" Text="50" Width="58" DockPanel.Dock="Right"/>
                                <TextBlock Text="{DynamicResource DefWidth}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Panel}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B0;" FontSize="13" Foreground="{StaticResource Dim}"/>
                                <TextBlock Text="{DynamicResource SecSel}" FontWeight="SemiBold" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Expander.Header>
                        <Grid>
                            <TextBlock x:Name="SelNone" Text="{DynamicResource SelNone}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            <Grid x:Name="SelInfo" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="3" Background="{StaticResource Checker}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
                                    <Image x:Name="SelThumb" Stretch="Uniform" Margin="4"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock x:Name="SelName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource SelSize}" Style="{StaticResource Label}" Margin="0,0,12,3"/>
                                        <TextBlock x:Name="SelSize" Grid.Column="1" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Grid.Row="1" Text="{DynamicResource SelRot}" Style="{StaticResource Label}" Margin="0,0,12,3"/>
                                        <TextBlock x:Name="SelRot" Grid.Row="1" Grid.Column="1"/>
                                        <TextBlock Grid.Row="2" Text="{DynamicResource SelPos}" Style="{StaticResource Label}" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="SelPos" Grid.Row="2" Grid.Column="1" Typography.NumeralAlignment="Tabular"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Click="Rotate_Click" Padding="8,2" ToolTip="R" AutomationProperties.Name="{DynamicResource RotSel}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" FontSize="12"/>
                                                <TextBlock Text="90°" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Click="DeletePlaced_Click" Margin="6,0,0,0" Width="28" Height="28"
                                                ToolTip="{DynamicResource DelSel}" AutomationProperties.Name="{DynamicResource DelSel}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Expander>

                    <Expander Style="{StaticResource Panel}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" FontSize="13" Foreground="{StaticResource Dim}"/>
                                <TextBlock Text="{DynamicResource SecPaper}" FontWeight="SemiBold" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <ComboBox x:Name="PaperBox" SelectionChanged="Paper_Changed"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource PaperW}" Style="{StaticResource Small}"/>
                                    <TextBox x:Name="CanvasW" Style="{StaticResource Num}" Text="297" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource PaperH}" Style="{StaticResource Small}"/>
                                    <TextBox x:Name="CanvasH" Style="{StaticResource Num}" Text="420" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#xE7AD;" Click="PaperRot_Click" VerticalAlignment="Bottom" Margin="6,0,0,0"
                                        ToolTip="{DynamicResource PaperRot}" AutomationProperties.Name="{DynamicResource PaperRot}"/>
                            </Grid>
                            <DockPanel Margin="0,10,0,0">
                                <TextBox x:Name="MarginBox" Style="{StaticResource Num}" Text="10" Width="58" DockPanel.Dock="Right"/>
                                <TextBlock Text="{DynamicResource MarginLbl}" Style="{StaticResource Label}"/>
                            </DockPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Style="{StaticResource Panel}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="13" Foreground="{StaticResource Dim}"/>
                                <TextBlock Text="{DynamicResource SecCut}" FontWeight="SemiBold" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="58"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Offset}" Style="{StaticResource Small}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{DynamicResource Smooth}" Style="{StaticResource Small}" HorizontalAlignment="Right"/>
                                <CheckBox x:Name="KissOn" Grid.Row="1" IsChecked="True" Margin="0,6,0,0" AutomationProperties.Name="{DynamicResource Kiss}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource KissBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Kiss}" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <TextBox x:Name="KissOff" Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" Text="2" Margin="0,6,0,0"/>
                                <TextBox x:Name="KissSm" Grid.Row="1" Grid.Column="3" Style="{StaticResource Num}" Text="1" Margin="0,6,0,0"/>
                                <CheckBox x:Name="DieOn" Grid.Row="2" Margin="0,6,0,0" AutomationProperties.Name="{DynamicResource Die}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource DieBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Die}" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <TextBox x:Name="DieOff" Grid.Row="2" Grid.Column="1" Style="{StaticResource Num}" Text="4" Margin="0,6,0,0"/>
                                <TextBox x:Name="DieSm" Grid.Row="2" Grid.Column="3" Style="{StaticResource Num}" Text="2" Margin="0,6,0,0"/>
                            </Grid>
                            <DockPanel Margin="0,10,0,0">
                                <TextBox x:Name="GapBox" Style="{StaticResource Num}" Text="2" Width="58" DockPanel.Dock="Right"/>
                                <TextBlock Text="{DynamicResource Gap}" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <TextBlock Text="{DynamicResource CutUnit}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.8"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Dokumen: tab + papan kerja -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Ink1}" Height="30" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Border HorizontalAlignment="Left" Background="{StaticResource Ink0}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,0"
                        Padding="14,0" Margin="8,0,0,-1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" FontSize="12" Foreground="{StaticResource Dim}"/>
                        <TextBlock x:Name="TabText" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
            <Grid>
                <ScrollViewer x:Name="View" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource Ink0}"
                              Focusable="True" FocusVisualStyle="{x:Null}" PreviewMouseWheel="View_Wheel"
                              PreviewMouseDown="View_PreviewDown" PreviewMouseMove="View_PreviewMove" PreviewMouseUp="View_PreviewUp">
                    <ItemsControl x:Name="Sheets" Margin="16" Background="Transparent"
                                  MouseLeftButtonDown="Sheets_Down" MouseMove="Sheets_Move" MouseLeftButtonUp="Sheets_Up">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <ContentControl Template="{StaticResource LogoMark}" Width="76" Height="76" Focusable="False"/>
                    <TextBlock Text="{DynamicResource EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6"/>
                    <TextBlock Text="{DynamicResource EmptyBody}" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                    <TextBlock Text="PDF, AI, CDR, PNG, JPG, SVG" Style="{StaticResource Small}" HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0.75"/>
                </StackPanel>
                <Border x:Name="DropHint" Visibility="Collapsed" Background="#CC1C1D20" BorderBrush="{StaticResource Accent}" BorderThickness="2"
                        CornerRadius="10" Margin="14" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="34" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource DropHint}" FontSize="16" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
