<Window x:Class="StickerLayout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticker Layout — Prototype (Profil mesin: Printech)" Width="1280" Height="820">
    <DockPanel>
        <ScrollViewer DockPanel.Dock="Left" Width="290" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <Button Content="Tambah gambar (PNG / SVG)…" Click="Add_Click" Padding="6"/>
                <TextBlock Text="Lebar stiker baru (mm)" Margin="0,8,0,0"/>
                <TextBox x:Name="WidthBox" Text="50"/>
                <TextBlock Text="Daftar stiker (nama · jumlah salinan)" Margin="0,10,0,2"/>
                <ListBox x:Name="List" Height="170">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="36" Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding Name}" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Hapus dari daftar" Click="Remove_Click" Margin="0,4,0,0"/>

                <Separator Margin="0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Lebar kanvas (mm)" Grid.Row="0" VerticalAlignment="Center"/><TextBox x:Name="CanvasW" Text="300" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Text="Tinggi kanvas (mm)" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="CanvasH" Text="400" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Text="Offset garis potong (mm)" Grid.Row="2" VerticalAlignment="Center"/><TextBox x:Name="OffsetBox" Text="2" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Text="Jarak antar stiker (mm)" Grid.Row="3" VerticalAlignment="Center"/><TextBox x:Name="GapBox" Text="2" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
                </Grid>
                <CheckBox x:Name="RegMarks" Content="Tanda registrasi di 4 sudut" IsChecked="True" Margin="0,6,0,0" Click="Refresh_Click"/>

                <Button Content="Susun otomatis" Click="Nest_Click" Padding="6" Margin="0,12,0,0" FontWeight="Bold"/>
                <Button Content="Compact (pangkas tinggi kanvas)" Click="Compact_Click" Padding="4" Margin="0,4,0,0"/>
                <Button Content="Putar terpilih 90°" Click="Rotate_Click" Padding="4" Margin="0,4,0,0"/>
                <Button Content="Hapus terpilih dari kanvas" Click="DeletePlaced_Click" Padding="4" Margin="0,4,0,0"/>
                <Button Content="Export SVG…" Click="Export_Click" Padding="6" Margin="0,12,0,0" FontWeight="Bold"/>
                <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#444"/>
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#888" FontSize="11"
                           Text="Seret stiker di kanvas untuk menggeser. Garis magenta = garis potong (layer CutContour)."/>
            </StackPanel>
        </ScrollViewer>
        <Slider DockPanel.Dock="Top" Minimum="1" Maximum="6" Value="2" ValueChanged="Zoom_Changed" Margin="10,6" ToolTip="Zoom"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#DDD">
            <Border x:Name="Host" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" BorderBrush="#888" BorderThickness="0.5"
                    MouseLeftButtonDown="Host_Down" MouseMove="Host_Move" MouseLeftButtonUp="Host_Up">
                <Border.LayoutTransform><ScaleTransform x:Name="Zoom" ScaleX="2" ScaleY="2"/></Border.LayoutTransform>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
